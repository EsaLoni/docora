# ==============================================================================
# Docora - Environment Configuration
# ==============================================================================
# Copy this file to .env and customize values for your local environment.
# Never commit .env or secrets to version control.

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME="Docora"
APP_TAGLINE="Your documents. Your intelligence."
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-secret-in-production
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 2. DATABASE & VECTOR STORE (PostgreSQL + pgvector or SQLite for dev)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docora_db
# Synchronous DB URL for Alembic migrations
DATABASE_SYNC_URL=postgresql+psycopg://postgres:postgres@localhost:5432/docora_db
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/docora_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
VECTOR_DIMENSION=384

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
AUTH_PROVIDER=local_or_supabase
ALLOW_DEV_AUTH=false
DEV_USER_EMAIL=dev@docora.ai
# For local JWT auth when working offline
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Supabase Auth Integration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ------------------------------------------------------------------------------
# 4. STORAGE CONFIGURATION
# ------------------------------------------------------------------------------
# Options: local | supabase
STORAGE_PROVIDER=local
# Local Storage Configuration
LOCAL_STORAGE_DIR=./storage/documents
# Supabase Storage Configuration
SUPABASE_STORAGE_BUCKET=udip-documents
SIGNED_URL_EXPIRATION_SECONDS=3600
# Upload limits (bytes) - default 25MB
MAX_UPLOAD_SIZE_BYTES=26214400
ALLOWED_FILE_EXTENSIONS=[".pdf",".docx",".xlsx",".csv",".pptx",".txt",".png",".jpg",".jpeg",".tiff"]

# ------------------------------------------------------------------------------
# 5. AI EMBEDDINGS & RETRIEVAL (CPU-Optimized)
# ------------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
HYBRID_RETRIEVAL_ALPHA=0.6  # 0.6 vector similarity, 0.4 keyword BM25/trigram
TOP_K_CHUNKS=6

# ------------------------------------------------------------------------------
# 6. LLM PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Options: mock (for zero-dependency offline test) | ollama | openai_compatible | gemini
LLM_PROVIDER=mock
LLM_MODEL_NAME=llama3.2:1b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=""
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ------------------------------------------------------------------------------
# 7. OCR CONFIGURATION
# ------------------------------------------------------------------------------
OCR_ENABLED=true
# Windows Tesseract path example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD_PATH=""
OCR_LANGUAGES=eng
OCR_FALLBACK_TO_IMAGE_EXTRACTION=true

# ------------------------------------------------------------------------------
# 8. FRONTEND ENVIRONMENT (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Docora"
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
