# ==============================================================================
# Docora
# Production Environment Variable Template
# ==============================================================================
# IMPORTANT: Copy this file to .env.production and replace all placeholder values.
# NEVER commit .env.production to source control!

# --- 1. Application Runtime ---
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
APP_NAME="Docora"
APP_TAGLINE="Your documents. Your intelligence."
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

# Cryptographic Secret: Generate using: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_SECURE_MIN_32_CHARACTERS_HEX_KEY

# Strict Allowed Web Origins (comma-separated or JSON list)
ALLOWED_ORIGINS=["https://docora.yourdomain.com"]

# --- 2. Database & Vector Store (PostgreSQL 16 + pgvector) ---
DATABASE_URL=postgresql+asyncpg://postgres:SECURE_DB_PASSWORD@postgres:5432/docora_db
DATABASE_SYNC_URL=postgresql+psycopg://postgres:SECURE_DB_PASSWORD@postgres:5432/docora_db
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:SECURE_DB_PASSWORD@postgres:5432/docora_db
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
VECTOR_DIMENSION=384

# --- 3. Authentication & Supabase ---
# CAUTION: ALLOW_DEV_AUTH is strictly blocked by the application in production!
ALLOW_DEV_AUTH=false
AUTH_PROVIDER=supabase
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-used-for-signature-verification
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://your-project-id.supabase.co/auth/v1

# --- 4. Storage Configuration ---
# Options: 'supabase' (recommended for production) or 'local'
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=docora-documents
LOCAL_STORAGE_DIR=/app/storage/documents
SIGNED_URL_EXPIRATION_SECONDS=3600
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB
DEFAULT_WORKSPACE_STORAGE_QUOTA_BYTES=524288000 # 500 MB

# --- 5. AI Embeddings & Semantic Retrieval (CPU-Optimized) ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
HYBRID_RETRIEVAL_ALPHA=0.6
TOP_K_CHUNKS=6
RETRIEVAL_RRF_K=60
MAX_SEARCH_LIMIT=50

# --- 6. LLM Inference Engine ---
# Options: 'gemini', 'openai_compatible', 'ollama', 'mock'
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-1.5-flash
GEMINI_API_KEY=your-google-gemini-api-key
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30.0

# --- 7. Production Security & Worker Reliability ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_INFERENCE_PER_MINUTE=40
MAX_REQUEST_BODY_SIZE_BYTES=31457280 # 30 MB
WORKER_CONCURRENCY=3
MALWARE_SCANNER_ENABLED=true

# --- 8. OCR Configuration ---
OCR_ENABLED=true
TESSERACT_CMD_PATH=/usr/bin/tesseract
OCR_LANGUAGES=eng
OCR_FALLBACK_TO_IMAGE_EXTRACTION=true
