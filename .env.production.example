# ==============================================================================
# Docora — Consolidated Production Environment Variable Template
# ==============================================================================
# Target Cloud SaaS Architecture:
# - Frontend: Vercel (Next.js 16)
# - Backend Web Service: Render Web Service (FastAPI)
# - Background Worker: Render Background Worker (Durable Ingestion & Intelligence)
# - Database: Supabase PostgreSQL 16 + pgvector (384-dim)
# - Document Storage: Supabase Storage (Private bucket)
# - AI Provider: Google Gemini
#
# IMPORTANT: Never commit actual secret keys or credentials to Git!
# Use this template to configure environment variables in Render and Vercel.

# ==============================================================================
# SECTION A: SHARED APPLICATION RUNTIME (Render Web Service & Worker)
# ==============================================================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
APP_NAME="Docora"
APP_TAGLINE="Your documents. Your intelligence."
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

# Cryptographic Secret: Generate using `openssl rand -hex 32`
# Required by both Web Service and Worker for token signing/verification
SECRET_KEY=REPLACE_WITH_SECURE_MIN_32_CHARACTERS_HEX_KEY

# Strict Allowed Web Origins for CORS (Render Web Service only)
# Comma-separated or JSON list of authorized frontend domains (no wildcards allowed in production)
ALLOWED_ORIGINS=["https://your-docora-app.vercel.app","https://docora.yourdomain.com"]

# ==============================================================================
# SECTION B: DATABASE & VECTOR STORE (Supabase PostgreSQL + pgvector)
# ==============================================================================
# 1. Asynchronous Application Database URL (used by Render Web Service and Worker)
# NOTE: Connect via Supabase Supavisor Transaction Pooler (port 6543) or Session Pooler (port 5432).
# If using transaction pooler (port 6543), include `prepared_statement_cache_size=0`.
DATABASE_URL=postgresql+asyncpg://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require&prepared_statement_cache_size=0

# 2. Synchronous Database URL (used by Alembic migrations & CLI tools)
# CAUTION: Alembic migrations MUST use Direct Connection (port 5432) or Session Pooler (port 5432).
# Never run migrations through transaction pooler (port 6543).
DATABASE_SYNC_URL=postgresql+psycopg://postgres:[DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?ssl=require
ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:[DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?ssl=require

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=15
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
VECTOR_DIMENSION=384

# ==============================================================================
# SECTION C: AUTHENTICATION & SUPABASE INTEGRATION
# ==============================================================================
AUTH_PROVIDER=supabase
ALLOW_DEV_AUTH=false
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_SECRET_KEY
SUPABASE_JWT_SECRET=REPLACE_WITH_SUPABASE_JWT_SECRET
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://[PROJECT_REF].supabase.co/auth/v1

# ==============================================================================
# SECTION D: STORAGE CONFIGURATION (Supabase Private Storage)
# ==============================================================================
# STORAGE_PROVIDER must be 'supabase' in production (local storage is strictly blocked in production)
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=udip-documents
SIGNED_URL_EXPIRATION_SECONDS=3600
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB
DEFAULT_WORKSPACE_STORAGE_QUOTA_BYTES=524288000 # 500 MB

# ==============================================================================
# SECTION E: AI PROVIDER & EMBEDDINGS (Google Gemini & Sentence Transformers)
# ==============================================================================
# LLM Provider
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-3.8-flash
GEMINI_API_KEY=REPLACE_WITH_GOOGLE_GEMINI_API_KEY
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=45.0

# CPU-Optimized Sentence Transformers Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=16
CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=50
HYBRID_RETRIEVAL_ALPHA=0.6
TOP_K_CHUNKS=6
RETRIEVAL_RRF_K=60
MAX_SEARCH_LIMIT=50

# ==============================================================================
# SECTION F: OCR CONFIGURATION
# ==============================================================================
OCR_ENABLED=true
TESSERACT_CMD_PATH=/usr/bin/tesseract
OCR_LANGUAGES=eng
OCR_FALLBACK_TO_IMAGE_EXTRACTION=true

# ==============================================================================
# SECTION G: RATE LIMITING & SECURITY (Render Web Service)
# ==============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_UPLOAD_PER_MINUTE=20
RATE_LIMIT_INFERENCE_PER_MINUTE=40
MAX_REQUEST_BODY_SIZE_BYTES=31457280 # 30 MB
MALWARE_SCANNER_ENABLED=true

# ==============================================================================
# SECTION H: BACKGROUND WORKER CONFIGURATION (Render Background Worker)
# ==============================================================================
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=2.0
WORKER_MAX_RETRIES=3
WORKER_JOB_TIMEOUT_SECONDS=300.0
WORKER_BATCH_SIZE=5
WORKER_STALE_JOB_TIMEOUT_MINUTES=15
WORKER_HEALTHCHECK_FILE=/tmp/worker_heartbeat.json

# ==============================================================================
# SECTION I: FRONTEND ENVIRONMENT VARIABLES (Vercel Project Settings)
# ==============================================================================
NEXT_PUBLIC_APP_NAME="Docora"
NEXT_PUBLIC_API_URL=https://your-docora-backend.onrender.com/api/v1
NEXT_PUBLIC_APP_URL=https://your-docora-app.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_SUPABASE_ANON_PUBLIC_KEY
