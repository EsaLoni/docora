# UDIP Automatic HTTPS Caddyfile
# Zero-configuration production reverse proxy with automatic Let's Encrypt SSL

{$DOMAIN:localhost} {
    # Automatic TLS & HSTS Header
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    # File upload size limits
    request_body {
        max_size 35MB
    }

    # Route API and streaming endpoints to FastAPI backend
    handle /api/* {
        reverse_proxy backend:8000 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
            flush_interval -1
        }
    }

    handle /metrics {
        reverse_proxy backend:8000
    }

    handle /health* {
        reverse_proxy backend:8000
    }

    # Route all other web traffic to Next.js frontend
    handle {
        reverse_proxy frontend:3000
    }
}
