# ==============================================================================
# Docora Frontend — Production Environment Variables (Vercel)
# ==============================================================================
# Configure these variables in your Vercel Project Dashboard under:
# Project Settings > Environment Variables > Production
#
# DO NOT include server-side secrets (DB credentials, Service Role keys, API keys).
# All NEXT_PUBLIC_* variables are bundled into client-side JavaScript.

# 1. Backend API Base URL (Render FastAPI Web Service)
# Points to your deployed Render API service including /api/v1 suffix.
NEXT_PUBLIC_API_URL=https://your-docora-backend.onrender.com/api/v1

# 2. Canonical Frontend Application URL
# Used for metadataBase, OpenGraph images, and OAuth redirect validation.
NEXT_PUBLIC_APP_URL=https://your-docora-app.vercel.app

# 3. Public Application Branding
NEXT_PUBLIC_APP_NAME="Docora"

# 4. Optional Supabase Client Credentials
# Only public anonymous keys should ever be configured with NEXT_PUBLIC_
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
